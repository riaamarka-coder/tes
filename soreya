    end
end)

-- // Background Loop Auto Checkpoint 1-20 -> Summit -> SummitExtra (Delay di Sini) -> Ulang dari CP 1
task.spawn(function()
    while true do
        if autoCheckpointEnabled then
            -- 1. Teleport dari Checkpoint 1 sampai 20 secara berurutan
            for i = 1, 20 do
                if not autoCheckpointEnabled then break end
                local key = "Checkpoint " .. i
                if CheckpointCoords[key] then
                    teleportToPosition(CheckpointCoords[key])
                end
                task.wait(cpDelay)
            end

            -- 2. Teleport ke Summit
            if autoCheckpointEnabled and CheckpointCoords["Summit"] then
                teleportToPosition(CheckpointCoords["Summit"])
            end
            task.wait(cpDelay)

            -- 3. Teleport ke Koordinat Ekstra setelah Summit
            if autoCheckpointEnabled and CheckpointCoords["SummitExtra"] then
                teleportToPosition(CheckpointCoords["SummitExtra"])
            end

            -- 4. Delay berjalan di koordinat ekstra setelah summit (sesuai settingan summitWaitTime)
            local elapsedSummitWait = 0
            while elapsedSummitWait < summitWaitTime do
                if not autoCheckpointEnabled then break end
                task.wait(0.1)
                elapsedSummitWait = elapsedSummitWait + 0.1
            end

            -- Setelah delay selesai, loop akan kembali mengulang dari Checkpoint 1
        else
            task.wait(0.5)
        end
    end
end)

