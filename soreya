-- // Fungsi Otomatis Mencari Pancingan (Multi-Rod Support)
local function getEquippedRod()
    local character = LocalPlayer.Character
    if not character then return nil end

    -- 1. Cari pancingan yang sedang dipegang di karakter
    for _, tool in ipairs(character:GetChildren()) do
        if tool:IsA("Tool") and tool:FindFirstChild("Mechanics") and tool.Mechanics:FindFirstChild("Remotes") then
            return tool
        end
    end

    -- 2. Jika di Backpack, auto-equip ke karakter dengan aman
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    for _, tool in ipairs(LocalPlayer.Backpack:GetChildren()) do
        if tool:IsA("Tool") and tool:FindFirstChild("Mechanics") and tool.Mechanics:FindFirstChild("Remotes") then
            if humanoid then
                pcall(function()
                    humanoid:EquipTool(tool)
                end)
            else
                tool.Parent = character
            end
            task.wait(0.2)
            return tool
        end
    end

    return nil
end

-- // Fungsi Utama Memancing (Perfect Cast 99 + Real-time MiniGame Tap)
local function doAutoFish()
    if not autoFishEnabled then return end
    
    local rod = getEquippedRod()
    if not rod then return end

    local mechanics = rod:FindFirstChild("Mechanics")
    local remotes = mechanics and mechanics:FindFirstChild("Remotes")
    if not remotes then return end

    local castEvent = remotes:FindFirstChild("CastEvent")
    local miniGameRemote = remotes:FindFirstChild("MiniGame")
    if not castEvent or not miniGameRemote then return end

    -- Step 1: Lempar Pancingan dengan Parameter 99 (Perfect Cast)
    pcall(function()
        castEvent:FireServer(true)
        task.wait(0.05)
        if not autoFishEnabled then return end
        castEvent:FireServer(
            false,
            99, -- Nilai 99 untuk lemparan sempurna (Perfect)
            Vector3.new(0.13821893930435181, 0, 0.99040168523788452)
        )
    end)

    -- Step 2: Efek Visual Tanda Seru Bersama (Opsional, dilindungi pcall)
    pcall(function()
        local tandaSeru = ReplicatedStorage:FindFirstChild("TandaSeruBersama")
        if tandaSeru then
            tandaSeru:FireServer(
                Color3.new(0.3333333432674408, 0.63529413938522339, 1),
                Color3.new(0.078431375324726105, 0.078431375324726105, 0.078431375324726105),
                ColorSequence.new({
                    ColorSequenceKeypoint.new(0, Color3.new(0.3333333432674408, 0.63529413938522339, 1)),
                    ColorSequenceKeypoint.new(1, Color3.new(0.3333333432674408, 0.63529413938522339, 1))
                }),
                1.5
            )
        end
    end)

    -- Step 3: Jeda hingga ikan menyangkut / bar minigame muncul
    local elapsedWait = 0
    while elapsedWait < castDelay do
        if not autoFishEnabled then return end
        task.wait(0.05)
        elapsedWait = elapsedWait + 0.05
    end

    -- Step 4: Real-time Continuous Tap/Spam Bar MiniGame
    local startTime = tick()
    while tick() - startTime < reelingDuration do
        if not autoFishEnabled then break end
        
        pcall(function()
            miniGameRemote:FireServer(true)
        end)
        
        task.wait(0.02)
    end
    
    -- Final trigger untuk memastikan sukses
    pcall(function()
        if autoFishEnabled then
            miniGameRemote:FireServer(true)
        end
    end)
end

-- // Fungsi Menjual Semua Ikan (Menggunakan InfoJual & JualSemua)
local function executeSell()
    local success = pcall(function()
        local mancingRemote = ReplicatedStorage:FindFirstChild("Remote") 
            and ReplicatedStorage.Remote:FindFirstChild("Mancing")
        
        if not mancingRemote then return false end

        local infoJual = mancingRemote:FindFirstChild("InfoJual")
        local jualSemua = mancingRemote:FindFirstChild("JualSemua")
        
        local executed = false

        if infoJual then
            pcall(function()
                infoJual:InvokeServer("semua")
                executed = true
            end)
        end

        if jualSemua then
            pcall(function()
                jualSemua:InvokeServer()
                executed = true
            end)
        end

        return executed
    end)
    return success
end

-- // Fungsi Teleport Berdasarkan Vector3
local function teleportToPosition(pos)
    local success = pcall(function()
        local character = LocalPlayer.Character
        if not character then return false end
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if not hrp then return false end

        hrp.CFrame = CFrame.new(pos)
        return true
    end)
    return success
end

-- // Background Loop Auto Fish
task.spawn(function()
    while true do
        if autoFishEnabled then
            local success, err = pcall(doAutoFish)
            if not success then
                task.wait(1)
            end
            task.wait(loopDelay)
        else
            task.wait(0.3)
        end
    end
end)

-- // Background Loop Auto Claim Inventory (Ambil Semua)
task.spawn(function()
    while true do
        if autoClaimEnabled then
            pcall(function()
                local remoteFolder = ReplicatedStorage:FindFirstChild("Remote")
                local inventarisFolder = remoteFolder and remoteFolder:FindFirstChild("Inventaris")
                local ambilSemua = inventarisFolder and inventarisFolder:FindFirstChild("AmbilSemua")
            
                if ambilSemua then
                    ambilSemua:InvokeServer()
                end
            end)
        end
        task.wait(2.5)
    end
end)

-- // Background Loop Auto Sell Berdasarkan Timer
