-- Helper: Memastikan Karakter & HumanoidRootPart Siap
local function GetRootPart()
    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hrp = character:WaitForChild("HumanoidRootPart", 5)
    return hrp, character
end

-- Helper Function: Equip Pickaxe / Tool
local function EquipPickaxe()
    local hrp, character = GetRootPart()
    if not character then return end
     
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid and not character:FindFirstChildOfClass("Tool") then
        local backpack = LocalPlayer:FindFirstChild("Backpack")
        if backpack then
            local toolName = PickaxeConfig and PickaxeConfig.ToolName or "Pickaxe"
            local tool = backpack:FindFirstChild(toolName) or backpack:FindFirstChildWhichIsA("Tool")
            if tool then
                humanoid:EquipTool(tool)
            end
        end
    end
end

-- Helper Function: Teleport Aman
local function TeleportTo(cframe)
    local hrp = GetRootPart()
    if hrp then
        hrp.CFrame = cframe
    end
end

-- Helper Function: Fetch Eggs Dynamically
local function GetAvailableEggs()
    local eggList = {}
    local zoneBuilds = Workspace:FindFirstChild("Build") and Workspace.Build:FindFirstChild("ZoneBuilds")
     
    if zoneBuilds then
        for _, zone in pairs(zoneBuilds:GetChildren()) do
            local eggsFolder = zone:FindFirstChild("Eggs")
            if eggsFolder then
                for idx, egg in pairs(eggsFolder:GetChildren()) do
                    table.insert(eggList, {
                        Name = zone.Name .. " - Egg " .. tostring(idx),
                        Instance = egg,
                        Zone = zone.Name
                    })
                end
            end
        end
    end
    return eggList
end

-- Collect Zone Names
local function GetZoneNames()
    local zones = { "All / Random" }
    local zoneBuilds = Workspace:FindFirstChild("Build") and Workspace.Build:FindFirstChild("ZoneBuilds")
    if zoneBuilds then
        for _, zone in pairs(zoneBuilds:GetChildren()) do
            table.insert(zones, zone.Name)
        end
    end
    return zones
end

--------------------------------------------------------------------------------
-- MAIN FARMING LOOP
--------------------------------------------------------------------------------
task.spawn(function()
    while task.wait(0.5) do
        if AutoFarmEnabled then
            -- Pastikan Karakter sudah spawned dan ter-load sempurna
            local hrp, character = GetRootPart()
            if not hrp or not character then
                task.wait(1)
                continue
            end

            local availableEggs = GetAvailableEggs()
             
            -- Filter target eggs
            local targetPool = {}
            if SelectedZone == "All / Random" then
                for _, eggData in ipairs(availableEggs) do
                    table.insert(targetPool, eggData.Instance)
                end
            else
                for _, eggData in ipairs(availableEggs) do
                    if eggData.Zone == SelectedZone then
                        table.insert(targetPool, eggData.Instance)
                    end
                end
            end

            if #targetPool > 0 and AutoFarmEnabled then
                local chosenEgg = targetPool[math.random(1, #targetPool)]
                local targetPart = chosenEgg:FindFirstChild("p1") or chosenEgg:FindFirstChildWhichIsA("BasePart") or chosenEgg

                if targetPart then
                    ------------------------------------------------------------
                    -- STEP 1: TP ke workspace.Build.Parts:GetChildren()[9] (START)
                    ------------------------------------------------------------
                    if not AutoFarmEnabled then break end
                    local baseParts = Workspace:FindFirstChild("Build") and Workspace.Build:FindFirstChild("Parts")
                    if baseParts then
                        local targetBasePart = baseParts:GetChildren()[9]
                        if targetBasePart and targetBasePart:IsA("BasePart") then
                            TeleportTo(targetBasePart.CFrame + Vector3.new(0, 3, 0))
                        end
                    end
                    task.wait(0.5)

                    ------------------------------------------------------------
                    -- STEP 2: Equip Pickaxe & TP ke Target Egg
                    ------------------------------------------------------------
                    if not AutoFarmEnabled then break end
                    EquipPickaxe()
                    task.wait(0.2)

                    if targetPart:IsA("BasePart") then
                        TeleportTo(targetPart.CFrame + Vector3.new(0, 3, 0))
                    elseif targetPart:IsA("Model") and targetPart.PrimaryPart then
                        TeleportTo(targetPart.PrimaryPart.CFrame + Vector3.new(0, 3, 0))
                    end
                    task.wait(0.4)

                    ------------------------------------------------------------
                    -- STEP 3: Auto Swing & Tunggu Prompt (Steal Egg)
                    ------------------------------------------------------------
                    if not AutoFarmEnabled then break end
                    if PickaxeController and PickaxeController.Swing then
                        pcall(function() PickaxeController.Swing(chosenEgg) end)
                    elseif AutoSwingController and AutoSwingController.SetOn then
                        pcall(function() AutoSwingController.SetOn(true) end)
                    end

                    local promptFound = false
                    local startTime = tick()
                     
                    repeat
                        task.wait(0.2)
                        if not AutoFarmEnabled then break end
                        local promptAnchor = Workspace:FindFirstChild("PromptAnchor")
                        if promptAnchor then
                            local prompt = promptAnchor:FindFirstChild("StealPrompt")
                            if prompt and prompt:IsA("ProximityPrompt") then
                                promptFound = true
                                fireproximityprompt(prompt)
                                break
                            end
                        end
                    until promptFound or (tick() - startTime > 12) or not AutoFarmEnabled

                    if not AutoFarmEnabled then break end
                    task.wait(0.8)

                    ------------------------------------------------------------
                    -- STEP 4: Teleport Kembali ke Base Player
                    ------------------------------------------------------------
                    if not AutoFarmEnabled then break end
                    local playerBaseHitbox = OwnBase.Hitbox()
                    if playerBaseHitbox then
                        TeleportTo(playerBaseHitbox.CFrame + Vector3.new(0, 4, 0))
                    else
                        local fallbackParts = Workspace:FindFirstChild("Build") and Workspace.Build:FindFirstChild("Parts")
                        if fallbackParts and fallbackParts:GetChildren()[9] then
                            TeleportTo(fallbackParts:GetChildren()[9].CFrame + Vector3.new(0, 3, 0))
                        end
                    end
                    task.wait(0.8)

                    ------------------------------------------------------------
                    -- STEP 5: Respon Ulang (Mati agar Egg Jatuh di Base)
                    ------------------------------------------------------------
                    if not AutoFarmEnabled then break end
                    local currentChar = LocalPlayer.Character
                    if currentChar then
                        local hum = currentChar:FindFirstChildOfClass("Humanoid")
                        if hum then
                            hum.Health = 0
                        end
                    end

                    -- Tunggu karakter respawn selesai penuh
                    LocalPlayer.CharacterAdded:Wait()
                    local newRoot = LocalPlayer.Character:WaitForChild("HumanoidRootPart", 10)
                    
                    -- Tunggu sebentar setelah respawn di base agar egg stabil di base
                    task.wait(1.5)
                    if not AutoFarmEnabled then break end

                    ------------------------------------------------------------
                    -- STEP 6: Promot Lagi (Ambil Egg yang tadi jatuh di Base)
                    ------------------------------------------------------------
                    local pickupPromptFound = false
                    local pickupStartTime = tick()

                    repeat
                        task.wait(0.2)
                        if not AutoFarmEnabled then break end
                        local promptAnchor = Workspace:FindFirstChild("PromptAnchor")
                        if promptAnchor then
                            local prompt = promptAnchor:FindFirstChildWhichIsA("ProximityPrompt") or promptAnchor:FindFirstChild("StealPrompt")
                            if prompt then
                                pickupPromptFound = true
                                fireproximityprompt(prompt)
                                break
                            end
                        end

                        -- Fallback cari prompt langsung dari workspace / egg model
                        for _, desc in ipairs(Workspace:GetDescendants()) do
                            if desc:IsA("ProximityPrompt") and desc.Enabled then
                                local parentPart = desc.Parent
                                if parentPart and newRoot and (parentPart.Position - newRoot.Position).Magnitude < 15 then
                                    pickupPromptFound = true
                                    fireproximityprompt(desc)
                                    break
                                end
                            end
                        end
                    until pickupPromptFound or (tick() - pickupStartTime > 6) or not AutoFarmEnabled

                    -- Jeda santai sebelum mengulang loop dari awal (start)
                    task.wait(1.5)
                end
            end
        end
    end
end)

