    PickaxeController = require(controllers:WaitForChild("PickaxeController"))
    AutoSwingController = require(controllers:WaitForChild("AutoSwingController"))
end)

--------------------------------------------------------------------------------
-- BASE DETECTION SYSTEM
--------------------------------------------------------------------------------
local OwnBase = {}
local v_u_7 = nil
local v_u_8 = {}
local v_u_9 = {}

local function v_u_14(p_u_10)
    if p_u_10:GetAttribute("OwnerUserId") == LocalPlayer.UserId then
        v_u_7 = p_u_10
        for _, v11 in table.clone(v_u_8) do
            if v11.Last ~= p_u_10 then
                v11.Last = p_u_10
                task.spawn(v11.Callback, p_u_10)
            end
        end
    end
    if not v_u_9[p_u_10] then
        v_u_9[p_u_10] = p_u_10:GetAttributeChangedSignal("OwnerUserId"):Connect(function()
            if p_u_10:GetAttribute("OwnerUserId") == LocalPlayer.UserId then
                local v12 = p_u_10
                v_u_7 = v12
                for _, v13 in table.clone(v_u_8) do
                    if v13.Last ~= v12 then
                        v13.Last = v12
                        task.spawn(v13.Callback, v12)
                    end
                end
            elseif v_u_7 == p_u_10 then
                v_u_7 = nil
            end
        end)
    end
end

local function v_u_17(p15)
    local v16 = v_u_9[p15]
    if v16 then
        v16:Disconnect()
        v_u_9[p15] = nil
    end
    if v_u_7 == p15 then
        v_u_7 = nil
    end
end

local function v_u_20(p18)
    for _, v19 in p18:GetChildren() do
        v_u_14(v19)
    end
    p18.ChildAdded:Connect(v_u_14)
    p18.ChildRemoved:Connect(v_u_17)
end

local PlotsFolder = Workspace:FindFirstChild("Plots")
if PlotsFolder then
    v_u_20(PlotsFolder)
else
    local v_u_22 = nil
    v_u_22 = Workspace.ChildAdded:Connect(function(p23)
        if p23.Name == "Plots" then
            if v_u_22 then
                v_u_22:Disconnect()
            end
            v_u_20(p23)
        end
    end)
end

function OwnBase.Get()
    if v_u_7 and v_u_7.Parent then
        return v_u_7
    else
        return nil
    end
end

function OwnBase.Hitbox()
    local baseModel = OwnBase.Get()
    if baseModel then
        local hitbox = baseModel:FindFirstChild("Hitbox") or baseModel:FindFirstChildWhichIsA("BasePart")
        if hitbox and hitbox:IsA("BasePart") then
            return hitbox
        end
    end
    return nil
end

