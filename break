MainTab:Toggle({
    Title = "Auto Steal & Return",
    Desc = "TP Start -> TP Egg -> Steal -> TP Base -> Respon Ulang -> Ambil Egg -> Ulangi dari Start",
    Icon = "play",
    Type = "Checkbox",
    Value = false,
    Callback = function(state)
        AutoFarmEnabled = state
        if not state then
            -- Jika toggle dimatikan, matikan juga autoswing
            if AutoSwingController and AutoSwingController.SetOn then
                pcall(function() AutoSwingController.SetOn(false) end)
            end
        else
            -- Jika di-on-kan kembali, alur otomatis dimulai dari Start (karena loop membaca ulang kondisi)
            if AutoSwingController and AutoSwingController.SetOn then
                pcall(function() AutoSwingController.SetOn(true) end)
            end
        end
    end
})

MainTab:Dropdown({
    Title = "Pilih Zona Egg",
    Desc = "Pilih area spesifik atau acak dari semua zona",
    Values = GetZoneNames(),
    Value = { "All / Random" },
    Multi = false,
    AllowNone = false,
    Callback = function(option)
        if type(option) == "table" then
            SelectedZone = option[1] or "All / Random"
        else
            SelectedZone = option
        end
    end
})
